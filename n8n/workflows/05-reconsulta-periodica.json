{
  "name": "05 — Reconsulta Periódica de CNPJs",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 0 6 * * 1" }]
        }
      },
      "id": "cron-reconsulta",
      "name": "Toda Segunda às 06h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"email\": \"n8n@everest.com.br\", \"senha\": \"{{ $env.N8N_API_PASSWORD }}\"}",
        "options": {}
      },
      "id": "login-reconsulta",
      "name": "Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/workflow-runs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"workflowId\": \"05-reconsulta-periodica\"}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }]
        },
        "options": {}
      },
      "id": "registrar-inicio",
      "name": "Registrar Início",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Login').first().json.access_token }}" }]
        },
        "options": {}
      },
      "id": "buscar-leads",
      "name": "Buscar Leads Ativos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-leads",
      "name": "Iterar Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-status",
              "leftValue": "={{ $json.status }}",
              "rightValue": "convertido",
              "operator": { "type": "string", "operation": "notEquals" }
            },
            {
              "id": "cond-descartado",
              "leftValue": "={{ $json.status }}",
              "rightValue": "descartado",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filtro-ativos",
      "name": "Apenas Ativos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:3000/cnpj/{{ $json.cnpj }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $('Login').first().json.access_token }}" }]
        },
        "options": {}
      },
      "id": "reconsultar-cnpj",
      "name": "Reconsultar CNPJ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-mudanca",
              "leftValue": "={{ $json.dados?.situacaoCadastral }}",
              "rightValue": "ATIVA",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "detectar-mudanca",
      "name": "Situação Mudou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/workflow-runs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowId: '05-reconsulta-periodica', payload: { cnpj: $json.dados?.cnpj, situacaoCadastral: $json.dados?.situacaoCadastral, alerta: 'Situação cadastral diferente de ATIVA detectada na reconsulta periódica' } }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }]
        },
        "options": {}
      },
      "id": "registrar-alerta",
      "name": "Registrar Alerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 60]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://host.docker.internal:3000/workflow-runs/{{ $('Registrar Início').first().json.id }}/concluir",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'concluido', resultado: { executadoEm: new Date().toISOString() } }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }]
        },
        "options": {}
      },
      "id": "registrar-conclusao",
      "name": "Registrar Conclusão",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 480]
    }
  ],
  "connections": {
    "Toda Segunda às 06h": {
      "main": [[{"node": "Login", "type": "main", "index": 0}]]
    },
    "Login": {
      "main": [[{"node": "Registrar Início", "type": "main", "index": 0}]]
    },
    "Registrar Início": {
      "main": [[{"node": "Buscar Leads Ativos", "type": "main", "index": 0}]]
    },
    "Buscar Leads Ativos": {
      "main": [[{"node": "Iterar Leads", "type": "main", "index": 0}]]
    },
    "Iterar Leads": {
      "main": [
        [{"node": "Apenas Ativos?", "type": "main", "index": 0}],
        [{"node": "Registrar Conclusão", "type": "main", "index": 0}]
      ]
    },
    "Apenas Ativos?": {
      "main": [
        [{"node": "Reconsultar CNPJ", "type": "main", "index": 0}],
        [{"node": "Iterar Leads", "type": "main", "index": 0}]
      ]
    },
    "Reconsultar CNPJ": {
      "main": [[{"node": "Situação Mudou?", "type": "main", "index": 0}]]
    },
    "Situação Mudou?": {
      "main": [
        [{"node": "Registrar Alerta", "type": "main", "index": 0}],
        [{"node": "Iterar Leads", "type": "main", "index": 0}]
      ]
    },
    "Registrar Alerta": {
      "main": [[{"node": "Iterar Leads", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "errorWorkflow": "" },
  "staticData": null,
  "meta": {
    "description": "Toda segunda-feira às 06h: busca leads ativos, reconsulta cada CNPJ na API do backend, detecta mudanças de situação cadastral e registra alertas.",
    "templateId": "05-reconsulta-periodica"
  },
  "pinData": {},
  "versionId": "3"
}
